---
import { sitePath } from '../lib/paths';

const workspaceLinks = [
  ['Dashboard', '/dashboard/', 'Project status and next actions'],
  ['Portfolio', '/portfolio/', 'Compare projects and priorities'],
  ['Work', '/work/', 'Tasks, results and handoffs'],
  ['Review', '/review/', 'Inspect results before accepting them'],
  ['Decisions', '/decisions/', 'Approvals and recovery choices'],
  ['Knowledge', '/knowledge/', 'Candidate and reviewed lessons'],
  ['Graph', '/graph/', 'Explore evidence and relationships'],
  ['Settings', '/settings/', 'Local connection and configuration'],
];
const primaryLinks = [
  ['Docs', '/docs/'],
  ['Workflow', '/docs/guides/operation-cycle.html'],
];
const current = (path: string) => Astro.url.pathname === sitePath(path) ? 'page' : undefined;
const linkClass = 'rounded-sm text-sm font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400';
---

<nav class="fixed inset-x-0 top-0 z-50 border-b border-surface-800/60 bg-surface-950/95 backdrop-blur-xl" aria-label="Main navigation">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-6">
    <a href={sitePath('/')} class="flex shrink-0 items-center gap-3 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400" aria-label="Forager home">
      <img src={sitePath('/assets/logo.svg')} alt="" width="32" height="32">
      <span class="text-lg font-semibold">Forager</span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {primaryLinks.map(([label, path]) => <a href={sitePath(path)} class={linkClass} aria-current={current(path)}>{label}</a>)}
      <details class="relative" data-nav-disclosure>
        <summary class={`${linkClass} cursor-pointer py-4`}>Workspace preview <span aria-hidden="true">⌄</span></summary>
        <div class="absolute right-0 top-full mt-1 w-[min(38rem,calc(100vw-3rem))] border border-surface-700 bg-surface-950 p-5 shadow-xl">
          <p class="mb-4 max-w-prose text-sm leading-relaxed text-slate-400">Explore sample data. Connect local exports to inspect your own work.</p>
          <div class="grid grid-cols-2 gap-1">
            {workspaceLinks.map(([label, path, description]) => (
              <a href={sitePath(path)} aria-current={current(path)} class="rounded-sm p-3 hover:bg-surface-800 focus-visible:outline-2 focus-visible:outline-brand-400">
                <span class="block text-sm font-semibold text-slate-100">{label}</span>
                <span class="mt-1 block text-sm text-slate-400">{description}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
      <a href="https://github.com/kimyoungjin06/forager-cli" class={linkClass}>GitHub</a>
      <a href="https://www.kisti.re.kr/" class="institution-badge rounded-lg px-3 py-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400" aria-label="KISTI">
        <img src={sitePath('/assets/kisti-logo-en.png')} alt="KISTI">
      </a>
    </div>

    <details class="lg:hidden" data-nav-disclosure>
      <summary class={`${linkClass} cursor-pointer px-2 py-3`}>Menu <span aria-hidden="true">⌄</span></summary>
      <div class="absolute inset-x-0 top-full max-h-[calc(100dvh-5rem)] overflow-y-auto border-b border-surface-700 bg-surface-950 px-6 py-5">
        <div class="flex flex-wrap gap-6 border-b border-surface-800 pb-5">
          {primaryLinks.map(([label, path]) => <a href={sitePath(path)} class={linkClass} aria-current={current(path)}>{label}</a>)}
          <a href="https://github.com/kimyoungjin06/forager-cli/releases" class={linkClass}>Releases</a>
          <a href="https://github.com/kimyoungjin06/forager-cli" class={linkClass}>GitHub</a>
        </div>
        <p class="mt-5 font-semibold text-slate-100">Workspace preview</p>
        <p class="mb-3 mt-2 max-w-prose text-sm leading-relaxed text-slate-400">Sample data. Connect local exports to inspect your own work.</p>
        <div class="grid grid-cols-2 gap-1">
          {workspaceLinks.map(([label, path]) => <a href={sitePath(path)} class={`${linkClass} px-2 py-3`} aria-current={current(path)}>{label}</a>)}
        </div>
        <a href="https://www.kisti.re.kr/" class="institution-badge mt-5 inline-flex rounded-lg px-3 py-2" aria-label="KISTI">
          <img src={sitePath('/assets/kisti-logo-en.png')} alt="KISTI">
        </a>
      </div>
    </details>
  </div>
</nav>

<style>
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  a[aria-current='page'] { color: var(--color-brand-300); }
</style>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]')];
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (!menu.open) continue;
      const returnFocus = menu.contains(document.activeElement);
      menu.open = false;
      if (returnFocus) menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    }
  });
</script>
