---
import { sitePath } from '../lib/paths';
const command = 'curl -fsSL https://raw.githubusercontent.com/kimyoungjin06/forager-cli/main/scripts/install.sh | bash';
---

<div class="code-block max-w-2xl rounded-lg p-5 text-left" data-install-block>
  <div class="mb-4 flex items-center justify-between gap-4">
    <span class="text-sm font-semibold text-slate-200">Install Forager</span>
    <button type="button" data-copy-install class="rounded-sm border border-surface-700 px-3 py-2 text-sm text-brand-300 hover:border-brand-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-400" aria-label="Copy install command">Copy</button>
  </div>
  <code data-install-command class="block break-all font-mono text-sm leading-relaxed text-slate-200">{command}</code>
  <p class="mt-4 text-sm text-slate-400" role="status" data-copy-feedback>Requires tmux and an installed coding CLI.</p>
  <a href={sitePath('/docs/installation.html')} class="mt-3 inline-block text-sm text-brand-300 underline underline-offset-4">Release downloads and source installation</a>
</div>

<script>
  for (const block of document.querySelectorAll<HTMLElement>('[data-install-block]')) {
    const button = block.querySelector<HTMLButtonElement>('[data-copy-install]');
    const feedback = block.querySelector<HTMLElement>('[data-copy-feedback]');
    const command = block.querySelector('[data-install-command]')?.textContent ?? '';
    button?.addEventListener('click', async () => {
      if (!feedback) return;
      try {
        await navigator.clipboard.writeText(command);
        feedback.textContent = 'Install command copied.';
      } catch {
        feedback.textContent = 'Copy is unavailable here. Select the command above.';
      }
    });
  }
</script>
